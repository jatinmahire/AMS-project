{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ams-project-bjcx.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://ams-project-bjcx.onrender.com/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
